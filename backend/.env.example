# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/postify

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ============================================
# RABBITMQ (CloudAMQP)
# ============================================
# Get your CloudAMQP URL from: https://customer.cloudamqp.com/instance
# Format: amqps://user:password@host.cloudamqp.com/vhost
# Example: amqps://abcdefgh:xyz123@shrimp.rmq.cloudamqp.com/abcdefgh
RABBITMQ_URL=amqps://your-user:your-password@your-instance.cloudamqp.com/your-vhost

# ============================================
# GOOGLE OAUTH 2.0
# ============================================
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ============================================
# FRONTEND URL
# ============================================
CLIENT_URL=http://localhost:3000

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ============================================
# CLOUDINARY FILE STORAGE
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAILS=admin@example.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
