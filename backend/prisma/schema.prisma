generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String?
  avatarUrl         String?
  provider          AuthProvider  @default(GOOGLE)
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  role              UserRole       @default(USER)
  applications      Application[]
  oauthTokens       OAuthToken[]
  cvs               UserCV[]
  userContacts      UserContacts[]

  @@unique([provider, providerAccountId])
  @@map("users")
}

model UserCV {
  id           String        @id @default(uuid())
  userId       String
  fileName     String
  fileKey      String
  fileSize     Int
  mimeType     String
  isActive     Boolean       @default(true)
  isArchived   Boolean       @default(false)
  archivedAt   DateTime?
  uploadedAt   DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parsedText   String?
  status       CVStatus      @default(PENDING)
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived])
  @@index([userId, isActive])
  @@index([isActive])
  @@map("user_cvs")
}

model Application {
  id             String            @id @default(uuid())
  userId         String
  cvId           String
  jobDescription String
  recruiterEmail String?
  subject        String?
  coverLetter    String?
  status         ApplicationStatus @default(DRAFT)
  errorMessage   String?
  retryCount     Int               @default(0)
  generatedAt    DateTime          @default(now())
  sentAt         DateTime?
  updatedAt      DateTime          @updatedAt
  cv             UserCV            @relation(fields: [cvId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([cvId])
  @@index([userId, generatedAt])
  @@index([status])
  @@index([userId, status, generatedAt])
  @@map("applications")
}

model OAuthToken {
  id           String    @id @default(uuid())
  userId       String
  provider     String    @default("gmail")
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_tokens")
}

enum AuthProvider {
  GOOGLE
}

enum ApplicationStatus {
  DRAFT
  SENT
  FAILED
}

enum CVStatus {
  PENDING
  DONE
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

model UserContacts {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@map("user_contacts")
}
